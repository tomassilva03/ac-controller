{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AC Controller",
  "version": "0.1.0",
  "identifier": "com.tomassilva.accontroller",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AC Controller",
        "width": 360,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "windowEffects": {
          "effects": [
            "acrylic",
            "hudWindow"
          ],
          "state": "active",
          "radius": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hon-bridge"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzQUZEREZENkUxNkQyM0MKUldRODBoWnUvZDJ2Zy9ucUJEOFdod1ZtT2RhZVp5NnRmcjhaRThCLzB0Ym4yTC9OS3JuK1NYRlQK",
      "endpoints": [
        "https://github.com/tomassilva03/ac-controller/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
